// 🚀 প্রোডাকশন স্কিমা — Vercel + TiDB Serverless (free tier)।
// মডেলগুলো prisma/schema.prisma (SQLite, local dev) এর সাথে হুবহু এক রাখো।
//
// Vercel-এ ডিপ্লয়ের সময় (vercel.json buildCommand):
//   prisma generate  +  prisma db push  — দুটোই এই ফাইল থেকে চলে।
// Vercel ড্যাশবোর্ডে Environment Variables:
//   DATABASE_URL = mysql://<user>:<pass>@<host>:4000/<db>?sslaccept=strict

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// শিক্ষার্থী + অ্যাডমিন — এক ডিভাইসে একটাই ফ্রি একাউন্ট (deviceHash unique)
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("student") // student | admin
  deviceHash   String?       @unique
  createdAt    DateTime      @default(now())
  sessions     Session[]
  questions    Question[]
  credits      DailyCredit[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

// দৈনিক ৩০ ক্রেডিট — তারিখ অনুযায়ী (Asia/Dhaka), রাত ১২টায় অটো রিসেট
model DailyCredit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD (Asia/Dhaka)
  used   Int    @default(0)
  @@unique([userId, date])
}

// অ্যাডমিনের AI কী পুল — Gemini ও Z.ai দুই ইঞ্জিনেরই (engine ফিল্ড), রাউন্ড-রবিন লোড ব্যালেন্সিং
model ApiKey {
  id        String   @id @default(cuid())
  engine    String   @default("gemini") // gemini | zai
  key       String   @unique
  label     String?
  active    Boolean  @default(true)
  lastError String?  @db.Text
  createdAt DateTime @default(now())
}

// সিস্টেম সেটিংস (মডেল নাম, দৈনিক কোটা)
model Setting {
  key   String @id
  value String
}

model Book {
  id        String    @id @default(cuid())
  title     String
  subject   String
  board     String?
  createdAt DateTime  @default(now())
  chapters  Chapter[]
}

model Chapter {
  id        String  @id @default(cuid())
  bookId    String
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title     String
  number    Int?
  pageStart Int?
  chunks    Chunk[]
  @@index([bookId])
}

// RAG চাঙ্ক — Gemini embedding ভেক্টর (JSON) TiDB-তে জমা
model Chunk {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  idx       Int
  content   String   @db.Text
  page      Int?
  embedding Json?
  embedded  Boolean  @default(false)
  @@index([chapterId])
  @@index([embedded])
}

model Question {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     String   @db.Text
  answer       String?  @db.Text
  answerTag    String?
  answerEngine String? // অ্যাডমিন অডিট — কোন ইঞ্জিন উত্তর দিয়েছে (স্টুডেন্ট দেখে না)
  answerModel  String? // অ্যাডমিন অডিট — কোন মডেল উত্তর দিয়েছে (স্টুডেন্ট দেখে না)
  references   Json?
  createdAt    DateTime @default(now())
  @@index([userId, createdAt])
}

// চ্যাট মডেল রেজিস্ট্রি — ইঞ্জিন প্রতি যত খুশি মডেল; নতুন মডেল এলে অ্যাডমিন প্যানেল থেকেই নাম বদলাও (কোড ছোঁয়ার দরকার নেই)
model AiModel {
  id        String       @id @default(cuid())
  engine    String // gemini | zai
  modelId   String // API মডেল আইডি — যেমন gemini-3.5-flash-lite / glm-4.5-flash
  label     String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  aliases   ModelAlias[]
  @@unique([engine, modelId])
  @@index([engine, active])
}

// মডেল-প্রতি স্বাক্ষর পুল — যত খুশি নাম/কোড (অ্যাডমিন লাইন বাই লাইন যোগ করে; উত্তরে র‍্যান্ডম একটা দেখাবে)
model ModelAlias {
  id        String   @id @default(cuid())
  aiModelId String
  aiModel   AiModel  @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  alias     String   @unique
  createdAt DateTime @default(now())
  @@index([aiModelId])
}
